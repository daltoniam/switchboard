[Unit]
Description=Switchboard MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# TCP defaults to 127.0.0.1. Add --listen-host 0.0.0.0 to expose HTTP/MCP.
# Optional native-gRPC-only socket: --grpc-socket /run/switchboard/awm.sock
ExecStart=/usr/bin/switchboard --port 3847
Restart=on-failure
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SWITCHBOARD_DAEMON=1

[Install]
WantedBy=default.target
