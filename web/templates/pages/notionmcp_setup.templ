package pages

import (
	"github.com/daltoniam/switchboard/web/templates/components"
	"github.com/daltoniam/switchboard/web/templates/layouts"
)

type NotionMCPSetupData struct {
	Enabled       bool
	HasToken      bool
	HealthChecked bool
	Healthy       bool
	FlashResult   string
	FlashError    string
}

templ NotionMCPSetup(page layouts.PageData, data NotionMCPSetupData) {
	@layouts.Base(page) {
		<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
			<a href="/integrations" class="btn btn-sm btn-outline" style="min-height: 44px;">← Back</a>
			<h1 class="page-title" style="margin-bottom: 0;">Notion MCP Setup</h1>
			if !data.HasToken {
				@components.Badge("Not Connected", "muted")
			} else if !data.Enabled {
				@components.Badge("Disabled", "muted")
			} else if data.HealthChecked && data.Healthy {
				@components.Badge("Connected", "green")
			} else if data.HealthChecked {
				@components.Badge("Connection Error", "red")
			} else {
				@components.Badge("Token Saved", "muted")
			}
		</div>
		<div aria-live="polite" aria-atomic="true">
			if data.FlashError != "" {
				<div class="flash flash-error">{ data.FlashError }</div>
			} else if data.FlashResult != "" {
				<div class="flash flash-success">{ data.FlashResult }</div>
			}
		</div>
		<p style="color: var(--text-secondary); margin-bottom: 1rem;">
			Connect the separate <code>notion-mcp</code> plugin to Notion's hosted MCP server. Your existing Notion integration is unaffected, including its browser token and settings.
		</p>
		<p style="margin-bottom: 1.5rem;">
			<a href="/integrations/notion/setup" class="btn btn-sm btn-outline" style="min-height: 44px;">Existing Notion setup</a>
		</p>
		<section aria-labelledby="notion-mcp-sign-in" style="border-top: 1px solid var(--border-subtle); padding-top: 1.5rem;">
			<div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1.5rem;">
				<div style="flex: 1 1 18rem; min-width: 0;">
					<h2 id="notion-mcp-sign-in" class="card-title" style="margin-bottom: 0.75rem;">Sign in with Notion</h2>
					<p style="color: var(--text-secondary); margin-bottom: 0.75rem;">
						Authorize access to search, read, and update Notion content through OAuth. Switchboard saves the access token in this plugin's configuration; it is never displayed here.
					</p>
					<p style="color: var(--text-muted);">
						Successful sign-in enables this plugin and makes its tools available immediately. Manage that setting in <a href="/integrations" style="color: var(--accent);">Integrations</a>.
					</p>
				</div>
				<div style="flex: 1 1 14rem; min-width: 0;">
					<button type="button" class="btn btn-green" id="notion-mcp-oauth-start" onclick="startNotionMCPOAuth()" style="min-height: 44px;">
						if data.HasToken {
							Re-authorize with Notion
						} else {
							Sign in with Notion →
						}
					</button>
					<div aria-live="polite" aria-atomic="true" style="margin-top: 0.75rem;">
						<p id="notion-mcp-oauth-status" style="color: var(--text-secondary);"></p>
						<div id="notion-mcp-oauth-error" class="flash flash-error" hidden></div>
					</div>
					<button type="button" class="btn btn-outline" id="notion-mcp-oauth-retry" onclick="startNotionMCPOAuth()" style="display: none; min-height: 44px;">Try Again</button>
					<noscript><p style="color: var(--text-secondary); margin-top: 0.75rem;">Enable JavaScript to sign in with Notion.</p></noscript>
				</div>
			</div>
		</section>
		<script>
			async function startNotionMCPOAuth() {
				var button = document.getElementById('notion-mcp-oauth-start');
				var retry = document.getElementById('notion-mcp-oauth-retry');
				var status = document.getElementById('notion-mcp-oauth-status');
				var error = document.getElementById('notion-mcp-oauth-error');
				if (button.disabled) return;
				button.disabled = true;
				button.setAttribute('aria-busy', 'true');
				retry.style.display = 'none';
				error.hidden = true;
				status.textContent = 'Starting secure sign-in…';
				var controller = new AbortController();
				var timeout = setTimeout(function() { controller.abort(); }, 30000);
				try {
					var response = await fetch('/api/remote/notion-mcp/oauth/start', { method: 'POST', signal: controller.signal });
					if (!response.ok) throw new Error('Could not start sign-in. Please try again.');
					var data = await response.json();
					if (data.error) throw new Error(data.error);
					if (!data.authorize_url) throw new Error('No sign-in URL was returned. Please try again.');
					var authorizeURL = new URL(data.authorize_url);
					if (authorizeURL.protocol !== 'https:' && authorizeURL.protocol !== 'http:') {
						throw new Error('Invalid sign-in URL. Please try again.');
					}
					status.textContent = 'Redirecting to Notion…';
					window.location.assign(authorizeURL.href);
				} catch (err) {
					status.textContent = '';
					error.textContent = err.name === 'AbortError' ? 'Sign-in timed out. Please try again.' : err.message;
					error.hidden = false;
					button.disabled = false;
					button.removeAttribute('aria-busy');
					retry.style.display = 'inline-flex';
					retry.focus();
				} finally {
					clearTimeout(timeout);
				}
			}
		</script>
	}
}
