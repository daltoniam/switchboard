package pages

import (
	"fmt"
	"net/url"
	"sort"
	"strings"

	"github.com/daltoniam/switchboard/web/templates/components"
	"github.com/daltoniam/switchboard/web/templates/layouts"
)

type CredentialField struct {
	Key   string
	Value string
}

// ToolInfo describes a single tool exposed by an integration so users
// can see what each operation does on the integration's detail page.
type ToolInfo struct {
	Name        string
	Description string
}

type IdentityCredentialField struct {
	Key        string
	Configured bool
}

type IdentityView struct {
	ID          string
	Label       string
	Credentials []IdentityCredentialField
	Metadata    []CredentialField
}

type IntegrationDetailData struct {
	Name                   string
	Enabled                bool
	Healthy                bool
	Credentials            []CredentialField
	PlainTextKeys          map[string]bool
	Placeholders           map[string]string
	OptionalKeys           map[string]bool
	ConnectOAuth           bool
	SupportsIdentities     bool
	IdentityCredentialKeys []string
	IdentityMetadataKeys   []string
	Identities             []IdentityView
	Tools                  []ToolInfo
}

func SortedCredentials(creds map[string]string) []CredentialField {
	keys := make([]string, 0, len(creds))
	for k := range creds {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	fields := make([]CredentialField, len(keys))
	for i, k := range keys {
		fields[i] = CredentialField{Key: k, Value: creds[k]}
	}
	return fields
}

func credPlaceholder(key string, placeholders map[string]string) string {
	if v, ok := placeholders[key]; ok {
		return v
	}
	return "Enter " + key
}

func credLabel(key string, optionalKeys map[string]bool) string {
	if optionalKeys[key] {
		return key + " (optional)"
	}
	return key
}

func credInputType(key string, plainTextKeys map[string]bool) string {
	if plainTextKeys[key] {
		return "text"
	}
	return "password"
}

func identityTitle(identity IdentityView) string {
	if identity.Label != "" {
		return identity.Label
	}
	return identity.ID
}

func identityFieldLabel(key string) string {
	return strings.ReplaceAll(key, "_", " ")
}

func identityCredentialPlaceholder(field IdentityCredentialField) string {
	if field.Configured {
		return "Configured — leave blank to keep"
	}
	return "Enter " + field.Key
}

templ IntegrationDetail(page layouts.PageData, data IntegrationDetailData) {
	@layouts.Base(page) {
		<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
			<a href="/integrations" class="btn btn-sm btn-outline">← Back</a>
			<h1 class="page-title" style="margin-bottom: 0; text-transform: capitalize;">{ data.Name }</h1>
			@components.Badge(healthLabel(data.Enabled, data.Healthy), healthBadge(data.Enabled, data.Healthy))
		</div>
		if data.ConnectOAuth {
			<div class="card">
				<button type="button" class="btn" form="integration-configuration" data-oauth-start={ "/api/integrations/" + data.Name + "/oauth/start" } onclick="connectPluginOAuth(this)">Connect OAuth</button>
				<p>Open this page using 127.0.0.1. OAuth tokens stay managed by Switchboard; connecting does not enable the integration.</p>
			</div>
			<script>
				async function connectPluginOAuth(button) {
					button.disabled = true;
					try {
						const credentials = {};
						for (const input of button.form.querySelectorAll('input[name^="cred_"]')) {
							credentials[input.name.slice(5)] = input.value;
						}
						const response = await fetch(button.dataset.oauthStart, {
							method: "POST",
							credentials: "same-origin",
							headers: {"Content-Type": "application/json"},
							body: JSON.stringify({credentials})
						});
						if (!response.ok) throw new Error("OAuth start failed. Check configuration and use the 127.0.0.1 address.");
						const data = await response.json();
						window.location.assign(data.authorize_url);
					} catch (error) {
						alert(error.message);
						button.disabled = false;
					}
				}
			</script>
		}
		<form id="integration-configuration" method="POST" action={ templ.SafeURL("/integrations/" + data.Name) }>
			<div class="card">
				<div class="card-header">
					<div class="card-title">Configuration</div>
					@components.Toggle("enabled", data.Enabled)
				</div>
				<div>
					for _, cred := range data.Credentials {
						@components.FormGroup(credLabel(cred.Key, data.OptionalKeys), "cred_" + cred.Key, credInputType(cred.Key, data.PlainTextKeys), cred.Value, credPlaceholder(cred.Key, data.Placeholders))
					}
				</div>
				<div class="identity-form-actions">
					<button type="submit" class="btn">Save Configuration</button>
				</div>
			</div>
		</form>
		if data.SupportsIdentities {
			<div class="card identity-editor">
				<div class="card-header identity-editor-header">
					<div>
						<div class="card-title">Named identities</div>
						<p class="identity-hint">Each tool call selects one identity by ID. Secret values are never rendered; leave a configured credential blank to keep it.</p>
					</div>
					@components.Badge(fmt.Sprintf("%d configured", len(data.Identities)), "muted")
				</div>
				if len(data.Identities) > 0 {
					<div class="identity-list">
						for _, identity := range data.Identities {
							<div class="identity-item">
								<div class="identity-item-heading">
									<div>
										<div class="identity-name">{ identityTitle(identity) }</div>
										<code class="identity-id">{ identity.ID }</code>
									</div>
									<form method="POST" action={ templ.SafeURL("/integrations/" + data.Name + "/identities/" + url.PathEscape(identity.ID) + "/delete") } onsubmit="return confirm('Delete this identity?');">
										<button type="submit" class="btn btn-sm btn-outline identity-delete">Delete</button>
									</form>
								</div>
								<form method="POST" action={ templ.SafeURL("/integrations/" + data.Name + "/identities") }>
									<input type="hidden" name="identity_id" value={ identity.ID }/>
									<div class="identity-fields">
										for _, field := range identity.Credentials {
											<div class="form-group">
												<label for={ "identity-" + identity.ID + "-cred-" + field.Key }>{ identityFieldLabel(field.Key) }</label>
												<input class="form-input" id={ "identity-" + identity.ID + "-cred-" + field.Key } type="password" name={ "identity_cred_" + field.Key } value="" placeholder={ identityCredentialPlaceholder(field) } autocomplete="off"/>
												if field.Configured {
													<span class="identity-secret-status">Configured</span>
												}
											</div>
										}
										for _, field := range identity.Metadata {
											<div class="form-group">
												<label class="form-label" for={ "identity-" + identity.ID + "-meta-" + field.Key }>{ identityFieldLabel(field.Key) }</label>
												<input class="form-input" type="text" name={ "identity_meta_" + field.Key } id={ "identity-" + identity.ID + "-meta-" + field.Key } value={ field.Value } placeholder={ "Enter " + field.Key }/>
											</div>
										}
									</div>
									<div class="identity-form-actions">
										<button type="submit" class="btn btn-sm">Save identity</button>
									</div>
								</form>
							</div>
						}
					</div>
				} else {
					<p class="identity-empty">No identities configured yet.</p>
				}
				<div class="identity-item identity-item-new">
					<div class="identity-item-heading">
						<div>
							<div class="identity-name">Add identity</div>
							<p class="identity-hint">Choose a stable, human-readable ID such as <code>work</code> or <code>personal</code>.</p>
						</div>
					</div>
					<form method="POST" action={ templ.SafeURL("/integrations/" + data.Name + "/identities") }>
						<div class="identity-fields">
							@components.FormGroup("identity id", "identity_id", "text", "", "work")
							if len(data.IdentityCredentialKeys) > 0 {
								<div class="identity-fieldset-heading">Credentials</div>
							}
							for _, key := range data.IdentityCredentialKeys {
								@components.FormGroup(identityFieldLabel(key) + " (required)", "identity_cred_" + key, "password", "", "Enter " + key)
							}
							if len(data.IdentityMetadataKeys) > 0 {
								<div class="identity-fieldset-heading">Metadata (optional)</div>
							}
							for _, key := range data.IdentityMetadataKeys {
								<div class="form-group">
									<label class="form-label" for={ "identity-new-meta-" + key }>{ identityFieldLabel(key) }</label>
									<input class="form-input" type="text" name={ "identity_meta_" + key } id={ "identity-new-meta-" + key } value="" placeholder={ "Enter " + key }/>
								</div>
							}
						</div>
						<div class="identity-form-actions">
							<button type="submit" class="btn btn-sm">Add identity</button>
						</div>
					</form>
				</div>
			</div>
		}
		if len(data.Tools) > 0 {
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.5rem;">Available Tools ({ fmt.Sprint(len(data.Tools)) })</div>
				<div class="tools-hint">Operations this integration exposes through the MCP server.</div>
				<div class="tools-rows">
					for _, t := range data.Tools {
						@components.ToolRow(t.Name, t.Description)
					}
				</div>
			</div>
		}
	}
}
