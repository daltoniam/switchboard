package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/daltoniam/switchboard/awm"
	"github.com/daltoniam/switchboard/web/templates/layouts"
	"github.com/daltoniam/switchboard/web/templates/components"
)

func projectHref(projectID string) string {
	return "/projects/" + url.PathEscape(projectID)
}

func projectWorkHref(projectID string) string {
	return projectHref(projectID) + "/work"
}

func workHref(projectID, kind, id string) string {
	return fmt.Sprintf("%s/%s/%s", projectWorkHref(projectID), kind, url.PathEscape(id))
}

func stateBadge(state string) string {
	switch state {
	case awm.StateOpen:
		return "green"
	case awm.StatePaused, awm.StateProposed:
		return "yellow"
	case awm.StateClosed:
		return "muted"
	case awm.StateAborted:
		return "red"
	default:
		return "muted"
	}
}

func formatTime(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return t.Local().Format("2006-01-02 15:04")
}

func joinCSV(items []string) string {
	if len(items) == 0 {
		return "—"
	}
	return strings.Join(items, ", ")
}

// ProjectWorkData is the project-scoped work hub payload.
type ProjectWorkData struct {
	ProjectID     string
	WorkProfiles  []awm.WorkProfile
	AgentProfiles []awm.AgentProfile
	WorkSessions  []awm.WorkSession
	StateFilter   string
}

templ ProjectWorkHub(page layouts.PageData, data ProjectWorkData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href={ templ.SafeURL(projectHref(data.ProjectID)) } style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← { data.ProjectID }</a>
		</p>
		<p class="section-title" style="margin-bottom: 0.25rem; letter-spacing: 0.04em;">Project work model</p>
		<h1 class="page-title" style="margin-bottom: 0.35rem;">Work</h1>
		<p style="color: var(--text-secondary); font-size: 0.875rem; max-width: 42rem; margin-bottom: 1.5rem;">
			Work profiles, agent profiles, and work sessions for
			<code style="font-family: var(--font-mono);">{ data.ProjectID }</code>.
			These are not MCP transport sessions.
		</p>

		<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;">
			<a class="btn btn-outline btn-sm" href={ templ.SafeURL(projectWorkHref(data.ProjectID) + "/profiles") }>
				Work profiles ({ fmt.Sprintf("%d", len(data.WorkProfiles)) })
			</a>
			<a class="btn btn-outline btn-sm" href={ templ.SafeURL(projectWorkHref(data.ProjectID) + "/agents") }>
				Agent profiles ({ fmt.Sprintf("%d", len(data.AgentProfiles)) })
			</a>
			<a class="btn btn-outline btn-sm" href={ templ.SafeURL(projectWorkHref(data.ProjectID) + "/sessions") }>
				Work sessions ({ fmt.Sprintf("%d", len(data.WorkSessions)) })
			</a>
		</div>

		<section class="metrics-section">
			<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
				<h2 class="section-title" style="margin-bottom: 0.75rem;">Sessions</h2>
				<form method="GET" action={ templ.SafeURL(projectWorkHref(data.ProjectID)) } style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
					<select name="state" class="form-input" style="width: auto;" aria-label="Filter by state">
						<option value="">All states</option>
						for _, st := range []string{"proposed", "open", "paused", "closed", "aborted"} {
							if data.StateFilter == st {
								<option value={ st } selected>{ st }</option>
							} else {
								<option value={ st }>{ st }</option>
							}
						}
					</select>
					<button type="submit" class="btn btn-outline btn-sm">Filter</button>
				</form>
			</div>
			if len(data.WorkSessions) == 0 {
				<div class="card" style="padding: 1.25rem;">
					<p style="color: var(--text-secondary); margin: 0;">No work sessions for this project.</p>
				</div>
			} else {
				@workSessionsTable(data.ProjectID, data.WorkSessions)
			}
		</section>

		<section class="metrics-section" style="margin-top: 1.75rem;">
			<h2 class="section-title">Work profiles</h2>
			if len(data.WorkProfiles) == 0 {
				<p style="color: var(--text-muted); font-size: 0.875rem;">No work profiles linked to this project.</p>
			} else {
				@workProfilesTable(data.ProjectID, data.WorkProfiles)
			}
		</section>

		<section class="metrics-section" style="margin-top: 1.75rem;">
			<h2 class="section-title">Agent profiles</h2>
			if len(data.AgentProfiles) == 0 {
				<p style="color: var(--text-muted); font-size: 0.875rem;">No agent profiles linked to this project.</p>
			} else {
				@agentProfilesTable(data.ProjectID, data.AgentProfiles)
			}
		</section>
	}
}

type WorkProfilesListData struct {
	ProjectID string
	Profiles  []awm.WorkProfile
}

templ WorkProfilesList(page layouts.PageData, data WorkProfilesListData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href={ templ.SafeURL(projectWorkHref(data.ProjectID)) } style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Work</a>
		</p>
		<h1 class="page-title">Work profiles</h1>
		<p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem;">
			Session blueprints for <code style="font-family: var(--font-mono);">{ data.ProjectID }</code>.
		</p>
		if len(data.Profiles) == 0 {
			<div class="card" style="padding: 1.25rem;">
				<p style="color: var(--text-secondary); margin: 0;">No work profiles. Create one with <code style="font-family: var(--font-mono);">project_work_profile_put</code>.</p>
			</div>
		} else {
			@workProfilesTable(data.ProjectID, data.Profiles)
		}
	}
}

templ workProfilesTable(projectID string, profiles []awm.WorkProfile) {
	<div class="table-wrap">
		<table class="metrics-table">
			<thead>
				<tr>
					<th>Profile</th>
					<th>Projects</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range profiles {
					<tr>
						<td>
							<a href={ templ.SafeURL(workHref(projectID, "profiles", p.WorkProfileID)) } style="color: var(--text); font-weight: 500; text-decoration: none;">
								if p.DisplayName != "" {
									{ p.DisplayName }
								} else {
									{ p.WorkProfileID }
								}
							</a>
							<div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">{ p.WorkProfileID }</div>
						</td>
						<td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">{ joinCSV(p.ProjectIDs) }</td>
						<td style="color: var(--text-secondary); max-width: 24rem;">
							if p.Description != "" {
								{ p.Description }
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

type WorkProfileDetailData struct {
	ProjectID string
	Profile   awm.WorkProfile
	NotFound  bool
	ID        string
	JSON      string
}

templ WorkProfileDetail(page layouts.PageData, data WorkProfileDetailData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href={ templ.SafeURL(projectWorkHref(data.ProjectID) + "/profiles") } style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Work profiles</a>
		</p>
		if data.NotFound {
			<div class="card" style="padding: 1.5rem;">
				<h1 class="page-title">Work profile not found</h1>
				<p style="color: var(--text-secondary);">No profile for <code style="font-family: var(--font-mono);">{ data.ID }</code> on this project.</p>
			</div>
		} else {
			<p class="section-title" style="margin-bottom: 0.25rem;">Work profile</p>
			<h1 class="page-title" style="margin-bottom: 0.35rem;">
				if data.Profile.DisplayName != "" {
					{ data.Profile.DisplayName }
				} else {
					{ data.Profile.WorkProfileID }
				}
			</h1>
			if data.Profile.Description != "" {
				<p style="color: var(--text-secondary); margin-bottom: 1rem;">{ data.Profile.Description }</p>
			}
			@kvCard("Identity", [][2]string{
				{"ID", data.Profile.WorkProfileID},
				{"Projects", joinCSV(data.Profile.ProjectIDs)},
				{"Intended resources", joinCSV(data.Profile.IntendedResources)},
			})
			@jsonCard(data.JSON)
		}
	}
}

type AgentProfilesListData struct {
	ProjectID string
	Profiles  []awm.AgentProfile
}

templ AgentProfilesList(page layouts.PageData, data AgentProfilesListData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href={ templ.SafeURL(projectWorkHref(data.ProjectID)) } style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Work</a>
		</p>
		<h1 class="page-title">Agent profiles</h1>
		<p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem;">
			Agent kinds linked to <code style="font-family: var(--font-mono);">{ data.ProjectID }</code>
			(via session use, id prefix, or constraints.project_id[s]).
		</p>
		if len(data.Profiles) == 0 {
			<div class="card" style="padding: 1.25rem;">
				<p style="color: var(--text-secondary); margin: 0;">No agent profiles for this project. Create one with <code style="font-family: var(--font-mono);">project_agent_profile_put</code>.</p>
			</div>
		} else {
			@agentProfilesTable(data.ProjectID, data.Profiles)
		}
	}
}

templ agentProfilesTable(projectID string, profiles []awm.AgentProfile) {
	<div class="table-wrap">
		<table class="metrics-table">
			<thead>
				<tr>
					<th>Profile</th>
					<th>Capabilities</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range profiles {
					<tr>
						<td>
							<a href={ templ.SafeURL(workHref(projectID, "agents", p.AgentProfileID)) } style="color: var(--text); font-weight: 500; text-decoration: none;">
								if p.DisplayName != "" {
									{ p.DisplayName }
								} else {
									{ p.AgentProfileID }
								}
							</a>
							<div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">{ p.AgentProfileID }</div>
						</td>
						<td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">{ joinCSV(p.Capabilities) }</td>
						<td style="color: var(--text-secondary); max-width: 24rem;">
							if p.Description != "" {
								{ p.Description }
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

type AgentProfileDetailData struct {
	ProjectID string
	Profile   awm.AgentProfile
	NotFound  bool
	ID        string
	JSON      string
}

templ AgentProfileDetail(page layouts.PageData, data AgentProfileDetailData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href={ templ.SafeURL(projectWorkHref(data.ProjectID) + "/agents") } style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Agent profiles</a>
		</p>
		if data.NotFound {
			<div class="card" style="padding: 1.5rem;">
				<h1 class="page-title">Agent profile not found</h1>
				<p style="color: var(--text-secondary);">No profile for <code style="font-family: var(--font-mono);">{ data.ID }</code>.</p>
			</div>
		} else {
			<p class="section-title" style="margin-bottom: 0.25rem;">Agent profile</p>
			<h1 class="page-title" style="margin-bottom: 0.35rem;">
				if data.Profile.DisplayName != "" {
					{ data.Profile.DisplayName }
				} else {
					{ data.Profile.AgentProfileID }
				}
			</h1>
