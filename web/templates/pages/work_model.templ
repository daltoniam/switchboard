// --- Work sessions ---

type WorkSessionsListData struct {
	Sessions      []awm.WorkSession
	StateFilter   string
	ProjectFilter string
}

templ WorkSessionsList(page layouts.PageData, data WorkSessionsListData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href="/work" style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Work</a>
		</p>
		<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem;">
			<div>
				<h1 class="page-title" style="margin-bottom: 0.25rem;">Work sessions</h1>
				<p style="color: var(--text-secondary); font-size: 0.875rem;">Bounded work episodes (not MCP connections).</p>
			</div>
			<form method="GET" action="/work/sessions" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
				<select name="state" class="form-input" style="width: auto;" aria-label="Filter by state">
					<option value="">All states</option>
					for _, st := range []string{"proposed", "open", "paused", "closed", "aborted"} {
						if data.StateFilter == st {
							<option value={ st } selected>{ st }</option>
						} else {
							<option value={ st }>{ st }</option>
						}
					}
				</select>
				<input type="text" name="project_id" value={ data.ProjectFilter } placeholder="project_id" class="form-input" style="width: 10rem;" aria-label="Filter by project"/>
				<button type="submit" class="btn btn-outline btn-sm">Filter</button>
			</form>
		</div>
		if len(data.Sessions) == 0 {
			<div class="card" style="padding: 1.25rem;">
				<p style="color: var(--text-secondary); margin: 0;">No work sessions match. Create with <code style="font-family: var(--font-mono);">project.work_session.create</code>.</p>
			</div>
		} else {
			@workSessionsTable(data.Sessions)
		}
	}
}

templ workSessionsTable(sessions []awm.WorkSession) {
	<div class="table-wrap">
		<table class="metrics-table">
			<thead>
				<tr>
					<th>Session</th>
					<th>State</th>
					<th>Project</th>
					<th>Profile</th>
					<th>Updated</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range sessions {
					<tr>
						<td>
							<a href={ templ.SafeURL(workHref("sessions", s.WorkSessionID)) } style="color: var(--text); font-weight: 500; text-decoration: none;">
								if s.DisplayName != "" {
									{ s.DisplayName }
								} else {
									{ s.WorkSessionID }
								}
							</a>
							<div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">{ s.WorkSessionID }</div>
						</td>
						<td>
							@components.Badge(s.State, stateBadge(s.State))
						</td>
						<td style="font-family: var(--font-mono); font-size: 0.75rem;">
							if s.ProjectID != "" {
								<a href={ templ.SafeURL("/projects/" + url.PathEscape(s.ProjectID)) } style="color: var(--text-secondary); text-decoration: none;">{ s.ProjectID }</a>
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
						<td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">
							if s.WorkProfileID != "" {
								<a href={ templ.SafeURL(workHref("profiles", s.WorkProfileID)) } style="color: var(--text-secondary); text-decoration: none;">{ s.WorkProfileID }</a>
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
						<td style="color: var(--text-muted); font-size: 0.8125rem;">{ formatTime(s.UpdatedAt) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

type WorkSessionDetailData struct {
	Session  awm.WorkSession
	NotFound bool
	ID       string
	JSON     string
}

templ WorkSessionDetail(page layouts.PageData, data WorkSessionDetailData) {
	@layouts.Base(page) {
		<p style="margin-bottom: 0.75rem;">
			<a href="/work/sessions" style="color: var(--text-secondary); text-decoration: none; font-size: 0.8125rem;">← Work sessions</a>
		</p>
		if data.NotFound {
			<div class="card" style="padding: 1.5rem;">
				<h1 class="page-title">Work session not found</h1>
				<p style="color: var(--text-secondary);">No session for <code style="font-family: var(--font-mono);">{ data.ID }</code>.</p>
			</div>
		} else {
			<p class="section-title" style="margin-bottom: 0.25rem;">Work session</p>
			<div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
				<h1 class="page-title" style="margin-bottom: 0;">
					if data.Session.DisplayName != "" {
						{ data.Session.DisplayName }
					} else {
						{ data.Session.WorkSessionID }
					}
				</h1>
				@components.Badge(data.Session.State, stateBadge(data.Session.State))
			</div>
			@kvCard("Identity", [][2]string{
				{"ID", data.Session.WorkSessionID},
				{"Project", data.Session.ProjectID},
				{"Project revision", data.Session.ProjectRevision},
				{"Work profile", data.Session.WorkProfileID},
				{"Agent profiles", joinCSV(data.Session.AgentProfileIDs)},
				{"Created", formatTime(data.Session.CreatedAt)},
				{"Updated", formatTime(data.Session.UpdatedAt)},
			})
			@jsonCard(data.JSON)
		}
	}
}

templ kvCard(title string, rows [][2]string) {
	<div class="card" style="margin-bottom: 1rem; padding: 1rem 1.25rem;">
		<div class="section-title" style="margin-bottom: 0.75rem;">{ title }</div>
		<div class="table-wrap">
			<table class="metrics-table">
				<tbody>
					for _, row := range rows {
						if row[1] != "" {
							<tr>
								<td style="color: var(--text-muted); width: 11rem;">{ row[0] }</td>
								<td style="font-family: var(--font-mono); font-size: 0.8125rem; word-break: break-all;">{ row[1] }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ jsonCard(raw string) {
	if raw != "" {
		<div class="card" style="padding: 1rem 1.25rem;">
			<div class="section-title" style="margin-bottom: 0.75rem;">JSON</div>
			<pre style="margin: 0; overflow-x: auto; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.45; color: var(--text-secondary); white-space: pre-wrap; word-break: break-word;">{ raw }</pre>
		</div>
	}
}
