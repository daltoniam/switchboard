}

templ agentProfilesTable(profiles []awm.AgentProfile) {
	<div class="table-wrap">
		<table class="metrics-table">
			<thead>
				<tr>
					<th>Profile</th>
					<th>Capabilities</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range profiles {
					<tr>
						<td>
							<a href={ templ.SafeURL(workHref("agents", p.AgentProfileID)) } style="color: var(--text); font-weight: 500; text-decoration: none;">
								if p.DisplayName != "" {
									{ p.DisplayName }
								} else {
									{ p.AgentProfileID }
								}
							</a>
							<div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">{ p.AgentProfileID }</div>
						</td>
						<td style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary);">{ joinCSV(p.Capabilities) }</td>
						<td style="color: var(--text-secondary); max-width: 24rem;">
							if p.Description != "" {
								{ p.Description }
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

