		<h1 class="page-title">Agent profiles</h1>
		<p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem;">
			Eligible agent kinds (not running instances).
		</p>
		if len(data.Profiles) == 0 {
			<div class="card" style="padding: 1.25rem;">
				<p style="color: var(--text-secondary); margin: 0;">No agent profiles. Create one with <code style="font-family: var(--font-mono);">project.agent_profile.put</code>.</p>
			</div>
		} else {
			@agentProfilesTable(data.Profiles)
		}
