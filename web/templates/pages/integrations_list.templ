package pages

import (
	"fmt"
	"sort"

	"github.com/daltoniam/switchboard/web/templates/layouts"
	"github.com/daltoniam/switchboard/web/templates/components"
)

type IntegrationsListData struct {
	Integrations []IntegrationSummary
}

func sortByName(items []IntegrationSummary) []IntegrationSummary {
	sorted := make([]IntegrationSummary, len(items))
	copy(sorted, items)
	sort.Slice(sorted, func(i, j int) bool {
		return sorted[i].Name < sorted[j].Name
	})
	return sorted
}

templ IntegrationsList(page layouts.PageData, data IntegrationsListData) {
	@layouts.Base(page) {
		@IntegrationsListResults(data)
	}
}

templ IntegrationsListResults(data IntegrationsListData) {
	<div id="integration-results">
		{{ count := len(data.Integrations) }}
		@components.PageHeader("Integrations", fmt.Sprintf("%d integrations", count)) {
			<form id="health-refresh" hx-preserve method="POST" action="/api/health/refresh" hx-post="/api/health/refresh" hx-target="#integration-results" hx-swap="outerHTML" hx-indicator="#integration-results" hx-disabled-elt="find button" hx-request='{"timeout":35000}' aria-describedby="page-refresh-status">
				<button type="submit" class="icon-button h-10 w-10" aria-label="Re-check all" title="Re-check all">
					<span class="refresh-icon" aria-hidden="true"></span>
				</button>
			</form>
		}
		<div id="integration-filters" hx-preserve role="search" aria-label="Filter integrations">
			<fieldset class="flex flex-wrap items-center gap-3 mb-6 min-w-0 border-0" disabled>
				<label for="integration-search" class="sr-only">Filter integrations</label>
				<input id="integration-search" type="search" class="form-input flex-1 min-w-40" placeholder="Filter integrations…" autocomplete="off" aria-controls="integration-grid"/>
				@components.ToggleGroup("Integration state") {
					@components.ToggleGroupItem("Enabled", "true", true)
					@components.ToggleGroupItem("Disabled", "false", true)
				}
			</fieldset>
		</div>
		<section class="metrics-section" aria-label="Integrations">
			<div id="integration-grid" class="integration-grid">
				for _, i := range sortByName(data.Integrations) {
					@integrationCard(i)
				}
			</div>
			<p class="text-secondary" data-integration-empty role="status" hidden?={ count > 0 }>No integrations match your filters.</p>
		</section>
	</div>
}

templ integrationCard(i IntegrationSummary) {
	<a href={ templ.SafeURL("/integrations/" + i.Name) } class="integration-card" data-enabled={ fmt.Sprint(i.Enabled) }>
		<div class="integration-card-header">
			@components.IntegrationIcon(i.Name)
			<span class="name">{ i.Name }</span>
			if i.IsRemote {
				@components.Badge("remote", "muted")
			}
		</div>
		<div class="integration-card-footer">
			@components.Badge(healthLabel(i.Enabled, i.Healthy), healthBadge(i.Enabled, i.Healthy))
			<span class="integration-card-tools">{ fmt.Sprintf("%d tools", i.ToolCount) }</span>
		</div>
	</a>
}
