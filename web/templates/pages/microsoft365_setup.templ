package pages

import (
	"fmt"

	"github.com/daltoniam/switchboard/web/templates/layouts"
	"github.com/daltoniam/switchboard/web/templates/components"
)

type Microsoft365SetupData struct {
	HasToken    bool
	Healthy     bool
	TokenSource string
	HasOAuth    bool
	ClientID    string
	TenantID    string
	RedirectURI string
	FlashResult string
	FlashError  string
	Tools       []ToolInfo
}

func microsoft365StatusBadge(hasToken bool, healthy bool) string {
	if healthy {
		return "green"
	}
	if hasToken {
		return "red"
	}
	return "muted"
}

func microsoft365StatusLabel(hasToken bool, healthy bool) string {
	if healthy {
		return "Connected"
	}
	if hasToken {
		return "Invalid Token"
	}
	return "Not Connected"
}

templ Microsoft365Setup(page layouts.PageData, data Microsoft365SetupData) {
	@layouts.Base(page) {
		<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
			<a href="/integrations" class="btn btn-sm btn-outline">← Back</a>
			<h1 class="page-title" style="margin-bottom: 0;">Microsoft 365 Setup</h1>
			@components.Badge(microsoft365StatusLabel(data.HasToken, data.Healthy), microsoft365StatusBadge(data.HasToken, data.Healthy))
		</div>
		if data.FlashResult != "" {
			<div class="flash flash-success">{ data.FlashResult }</div>
		}
		if data.FlashError != "" {
			<div class="flash flash-error">{ data.FlashError }</div>
		}
		if data.HasToken && data.Healthy {
			<div class="card">
				<div class="card-header">
					<div class="card-title">Current Connection</div>
					@components.Badge("Connected", "green")
				</div>
				<p style="color: var(--text-muted); font-size: 0.85rem;">
					Microsoft 365 is connected
					if data.TokenSource != "" {
						<span> via <strong>{ data.TokenSource }</strong></span>
					}
					. You can re-authenticate below to get a new token.
				</p>
			</div>
		}
		<div class="card">
			<div class="card-title" style="margin-bottom: 0.75rem;">Azure AD / Entra ID App</div>
			<p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem;">
				Register an app in the
				<a href="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank" style="color: var(--accent);">Microsoft Entra admin center</a>.
				Add a Web redirect URI of
				<code style="font-size: 0.8rem; background: var(--bg); padding: 0.15em 0.4em; border-radius: 3px;">{ data.RedirectURI }</code>
				and grant delegated Graph permissions for Mail, Calendars, Files, Teams, Tasks, and User.Read.
			</p>
			<form method="POST" action="/api/microsoft365/save-oauth-credentials">
				@components.FormGroup("Application (client) ID", "client_id", "text", data.ClientID, "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx")
				@components.FormGroup("Client Secret", "client_secret", "password", "", "Azure AD client secret")
				@components.FormGroup("Tenant ID", "tenant_id", "text", data.TenantID, "common (default), organizations, or a directory ID")
				<button type="submit" class="btn">Save OAuth Credentials</button>
			</form>
		</div>
		if data.HasOAuth {
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.75rem;">Sign in with Microsoft</div>
				<p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem;">
					Authenticate using Microsoft's OAuth 2.0 PKCE flow. You'll be redirected to Microsoft to authorize Outlook, OneDrive, Teams, and To Do access, then sent back automatically.
				</p>
				<div id="oauth-container">
					<button type="button" class="btn" id="oauth-start-btn" onclick="startM365OAuth()">
						Sign in with Microsoft
					</button>
				</div>
				<div id="oauth-error" style="display: none;">
					<div class="flash flash-error" id="oauth-error-msg"></div>
					<button type="button" class="btn btn-outline" onclick="resetOAuth()" style="margin-top: 0.5rem;">Try Again</button>
				</div>
			</div>
		}
		<div class="card">
			<div class="card-title" style="margin-bottom: 0.75rem;">
				if data.HasOAuth {
					Manual Access Token Entry
				} else {
					Access Token
				}
			</div>
			<p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem;">
				Alternatively, paste a Microsoft Graph OAuth access token directly.
			</p>
			<form method="POST" action="/api/microsoft365/save-token">
				@components.FormGroup("Access Token", "access_token", "password", "", "eyJ0eXAiOiJKV1Qi...")
				<button type="submit" class="btn">Save Token</button>
			</form>
		</div>
		if len(data.Tools) > 0 {
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.5rem;">Available Tools ({ fmt.Sprint(len(data.Tools)) })</div>
				<div class="tools-hint">Operations this integration exposes through the MCP server.</div>
				<div class="tools-rows">
					for _, t := range data.Tools {
						@components.ToolRow(t.Name, t.Description)
					}
				</div>
			</div>
		}
		<script>
			function startM365OAuth() {
				document.getElementById('oauth-start-btn').disabled = true;
				document.getElementById('oauth-start-btn').textContent = 'Starting...';

				fetch('/api/microsoft365/oauth/start', { method: 'POST' })
					.then(function(r) { return r.json(); })
					.then(function(data) {
						if (data.error) {
							showOAuthError(data.error);
							return;
						}
						window.location.href = data.authorize_url;
					})
					.catch(function(err) {
						showOAuthError('Failed to start OAuth flow: ' + err.message);
					});
			}

			function showOAuthError(msg) {
				document.getElementById('oauth-container').style.display = 'none';
				document.getElementById('oauth-error').style.display = 'block';
				document.getElementById('oauth-error-msg').textContent = msg;
			}

			function resetOAuth() {
				document.getElementById('oauth-error').style.display = 'none';
				document.getElementById('oauth-container').style.display = 'block';
				document.getElementById('oauth-start-btn').disabled = false;
				document.getElementById('oauth-start-btn').textContent = 'Sign in with Microsoft';
			}
		</script>
	}
}
