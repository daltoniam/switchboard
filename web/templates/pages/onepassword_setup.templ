package pages

import (
	"fmt"

	"github.com/daltoniam/switchboard/web/templates/components"
	"github.com/daltoniam/switchboard/web/templates/layouts"
)

type OnePasswordSetupData struct {
	Enabled             bool
	Healthy             bool
	AccountName         string
	ServiceAccountToken string
	DesktopAvailable    bool
	SignInError         string
	Tools               []ToolInfo
}

func (d OnePasswordSetupData) configured() bool {
	return d.AccountName != "" || d.ServiceAccountToken != ""
}

func (d OnePasswordSetupData) methodLabel() string {
	if d.AccountName != "" {
		return "Signing in through the 1Password desktop app as " + d.AccountName + "."
	}
	return "Signing in with a service account token."
}

templ OnePasswordSetup(page layouts.PageData, data OnePasswordSetupData) {
	@layouts.Base(page) {
		<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
			<a href="/integrations" class="btn btn-sm btn-outline" style="min-height: 44px;">← Back</a>
			@components.IntegrationIcon("onepassword")
			<h1 class="page-title" style="margin-bottom: 0;">1Password Setup</h1>
			if !data.configured() {
				@components.Badge("Not Configured", "muted")
			} else {
				@components.Badge(healthLabel(data.Enabled, data.Healthy), healthBadge(data.Enabled, data.Healthy))
			}
		</div>
		<form id="integration-configuration" method="POST" action="/integrations/onepassword">
			<div class="card">
				<div class="card-header">
					<div class="card-title">Enabled</div>
					@components.Toggle("enabled", data.Enabled)
				</div>
				<p class="slack-desc">
					Read, create, update, archive and delete 1Password items and resolve <code>op://</code> secret references through the official 1Password SDK. Fill in one option below and leave the other empty. Existing service account tokens keep working, and <code>OP_ACCOUNT_NAME</code> or <code>OP_SERVICE_ACCOUNT_TOKEN</code> can set them instead.
				</p>
				if data.configured() && data.Enabled {
					<p id="onepassword-method" class="slack-desc">{ data.methodLabel() }</p>
					if !data.Healthy && data.SignInError != "" {
						<div id="onepassword-sign-in-error" class="flash flash-error" role="alert" style="overflow-wrap: anywhere;">{ data.SignInError }</div>
					}
				}
			</div>
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.75rem;">Option 1: 1Password Desktop App (Recommended)</div>
				<p class="slack-desc">
					Sign in with your own account and approve access in the 1Password app, with no token to manage. Switchboard must run on this computer in your session while the app is open; it cannot reach the app from Docker, over SSH or as a system service. <a href="https://developer.1password.com/docs/sdks/concepts#1password-desktop-app" target="_blank" rel="noopener noreferrer" class="slack-link">How desktop app sign-in works</a>
				</p>
				if !data.DesktopAvailable {
					<div id="onepassword-desktop-unavailable" class="flash flash-error" role="note">
						This Switchboard build cannot use the 1Password desktop app because it was built without CGO, as prebuilt macOS and Linux downloads are. Build it on this computer with <code>go install</code> or <code>make build</code>, or use a service account.
					</div>
				}
				<div class="slack-steps">
					<div class="slack-step">
						<div class="slack-step-num">1</div>
						<div>
							<strong>Install and sign in to the 1Password app</strong>
							<p class="slack-step-detail">Install the <a href="https://1password.com/downloads/" target="_blank" rel="noopener noreferrer" class="slack-link">1Password app</a> on this computer and sign in to your account.</p>
						</div>
					</div>
					<div class="slack-step">
						<div class="slack-step-num">2</div>
						<div>
							<strong>Turn on the SDK integration</strong>
							<p class="slack-step-detail">In 1Password, open <strong>Settings</strong> → <strong>Developer</strong>. Under <strong>Developer Integrations</strong>, turn on <strong>Integrate with 1Password SDKs</strong>. Optional: to approve with Touch ID, Windows Hello or system authentication, turn it on in <strong>Settings</strong> → <strong>Security</strong>.</p>
						</div>
					</div>
					<div class="slack-step">
						<div class="slack-step-num">3</div>
						<div>
							<strong>Enter your account name</strong>
							<p class="slack-step-detail">Use the account name shown at the top of the 1Password sidebar, or the account ID. Leave the service account token empty, then enable and save.</p>
						</div>
					</div>
					<div class="slack-step">
						<div class="slack-step-num">4</div>
						<div>
							<strong>Approve the prompt</strong>
							<p class="slack-step-detail">When Switchboard first connects, 1Password asks you to approve it. The approval lasts until 1Password locks or Switchboard is idle for 10 minutes, and covers every vault your account can open, including Personal and Private vaults.</p>
						</div>
					</div>
				</div>
				@components.FormGroup("Account name", "cred_account_name", "text", data.AccountName, "Account name shown at the top of the 1Password desktop app sidebar")
			</div>
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.75rem;">Option 2: Service Account</div>
				<p class="slack-desc">
					A token limited to the vaults and permissions you choose, for headless or shared servers where the desktop app is not running.
				</p>
				<div class="slack-steps">
					<div class="slack-step">
						<div class="slack-step-num">1</div>
						<div>
							<strong>Open the service account wizard on 1Password.com</strong>
							<p class="slack-step-detail">Service accounts are created in your browser, not in the desktop app. Sign in to 1Password.com and open the <a href="https://start.1password.com/developer-tools/infrastructure-secrets/serviceaccount/" target="_blank" rel="noopener noreferrer" class="slack-link">service account wizard</a>, or go to <strong>Developer</strong> → <strong>Directory</strong>, select <strong>Other</strong> under Infrastructure Secrets Management, then <strong>Create a Service Account</strong>. An administrator may need to allow you to create one.</p>
						</div>
					</div>
					<div class="slack-step">
						<div class="slack-step-num">2</div>
						<div>
							<strong>Choose vaults and permissions</strong>
							<p class="slack-step-detail">Pick only the vaults Switchboard should see. Read items is enough for the read tools; create, update, archive and delete need write items. Personal, Private, Employee and the default Shared vault cannot be added, and access cannot be changed later.</p>
						</div>
					</div>
					<div class="slack-step">
						<div class="slack-step-num">3</div>
						<div>
							<strong>Paste the token</strong>
							<p class="slack-step-detail">Copy the token (<code>ops_...</code>). It is shown once, so save it in 1Password. Paste it here, leave the account name empty, then enable and save. <a href="https://developer.1password.com/docs/service-accounts/get-started/" target="_blank" rel="noopener noreferrer" class="slack-link">Service account guide</a></p>
						</div>
					</div>
				</div>
				@components.FormGroup("Service account token", "cred_service_account_token", "password", data.ServiceAccountToken, "Optional service account token (ops_...) for headless setups")
			</div>
			<div class="identity-form-actions" style="margin-bottom: 1.5rem;">
				<button type="submit" class="btn">Save Configuration</button>
			</div>
		</form>
		if len(data.Tools) > 0 {
			<div class="card">
				<div class="card-title" style="margin-bottom: 0.5rem;">Available Tools ({ fmt.Sprint(len(data.Tools)) })</div>
				<div class="tools-hint">Operations this integration exposes through the MCP server.</div>
				<div class="tools-rows">
					for _, t := range data.Tools {
						@components.ToolRow(t.Name, t.Description)
					}
				</div>
			</div>
		}
	}
}
