package layouts

import (
	_ "embed"
	"encoding/json"
	"strings"

	"github.com/daltoniam/switchboard/version"
)

//go:embed themes.json
var themeConfig []byte

type appearanceConfig struct {
	Defaults  map[string]string `json:"defaults"`
	FontSizes []string          `json:"fontSizes"`
	Themes    []themeOption     `json:"themes"`
}

type themeOption struct {
	ID     string `json:"id"`
	Name   string `json:"name"`
	Scheme string `json:"scheme"`
}

func appearanceSettings() appearanceConfig {
	var config appearanceConfig
	if err := json.Unmarshal(themeConfig, &config); err != nil {
		panic("invalid embedded theme configuration: " + err.Error())
	}
	return config
}

type PageData struct {
	Title        string
	CurrentPath  string
	FlashSuccess string
	FlashError   string
	Version      string
}

type NavItem struct {
	Path  string
	Label string
	Icon  string
}

func navItems() []NavItem {
	return []NavItem{
		{Path: "/", Label: "Dashboard", Icon: "i-lucide:layout-dashboard"},
		{Path: "/projects", Label: "Projects", Icon: "i-lucide:folder"},
		{Path: "/integrations", Label: "Integrations", Icon: "i-lucide:plug"},
		{Path: "/plugins", Label: "Plugin Marketplace", Icon: "i-lucide:store"},
		{Path: "/settings", Label: "Settings", Icon: "i-lucide:settings"},
	}
}

func isActive(current, path string) bool {
	if path == "/" {
		return current == "/"
	}
	return strings.HasPrefix(current, path)
}

templ themeSwatch(id string) {
	<span class="theme-swatch" data-theme={ id } aria-hidden="true">
		<span class="bg-accent"></span>
		<span class="bg-positive"></span>
		<span class="bg-warning"></span>
		<span class="bg-negative"></span>
	</span>
}

templ Base(data PageData) {
	{{ appearance := appearanceSettings() }}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title } — Switchboard</title>
			@appearanceBootstrap(appearance)
			<link rel="stylesheet" href="/static/style.css"/>
			<script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.10/dist/autoComplete.min.js" integrity="sha384-cLawOb2F3v0Zfax5NIlJRiJLXwaGoV0vezUUxIAvxIZDfx/jXGa8xOYNTXS8/cu4" crossorigin="anonymous"></script>
			<script type="module" src="/static/ui.mjs"></script>
			<style>
				:root {
					--accent-dim:     color-mix(in srgb, var(--accent) 12%, transparent);
					--accent-active:  color-mix(in srgb, var(--accent) 24%, transparent);
					--green-dim:      color-mix(in srgb, var(--green) 12%, transparent);
					--red-dim:        color-mix(in srgb, var(--red) 12%, transparent);
					--yellow-dim:     color-mix(in srgb, var(--yellow) 12%, transparent);
					--radius:         6px;
					--font-mono:      'SF Mono', ui-monospace, 'Cascadia Code', 'Fira Code', Menlo, monospace;
					--header-height:  3.5rem;
				}
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, Helvetica, Arial, sans-serif;
					background: var(--bg);
					line-height: 1.5;
					display: flex;
					min-height: 100vh;
					-webkit-font-smoothing: antialiased;
				}

				/* --- Sidebar --- */
				.sidebar[hidden], [data-sidebar="closed"] .sidebar { display: none; }
				@media (max-width: 1024px) {
					[data-sidebar] .sidebar { position: fixed; left: 0; top: var(--header-height); width: max-content; height: calc(100dvh - var(--header-height)); z-index: 40; }
					:root:not([data-sidebar]) body { flex-direction: column; }
					:root:not([data-sidebar]) .sidebar { position: static; width: 100%; min-width: 0; height: auto; }
				}
				.nav-item { white-space: nowrap; }
				.nav-item.active {
					color: var(--accent);
					border-left-color: var(--accent);
					background: var(--accent-dim);
				}
				.btn[aria-pressed="true"] {
					color: var(--accent);
					border-color: var(--accent);
					background: var(--accent-active);
				}
				.appearance-picker summary { list-style: none; }
				.appearance-picker summary::-webkit-details-marker { display: none; }
				.appearance-picker summary[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
				.theme-option:has(input:checked) { color: var(--accent); background: var(--accent-dim); }
				.theme-option:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
				.theme-option input:not(:checked) ~ .theme-check { visibility: hidden; }
				.search-dialog::backdrop { background: rgb(0 0 0 / 0.4); }
				.flash { animation: fade-in 0.15s ease-out; }
				.flash[hidden] { display: none; }
				.toast { background: color-mix(in srgb, currentColor 12%, var(--surface)); }
				.section-loading {
					position: relative;
					height: var(--refresh-height);
					min-height: var(--refresh-height);
					max-height: var(--refresh-height);
					visibility: hidden;
				}
				.section-loading::after {
					content: "";
					position: absolute;
					inset: 0;
					margin: auto;
					visibility: visible;
					color: var(--text-muted);
				}
				@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
				@media (prefers-reduced-motion: reduce) {
					*, *::before, *::after { animation: none !important; transition: none !important; }
				}

				/* --- Forms --- */
				select.form-input {
					appearance: none;
					background-image: var(--select-chevron);
					background-position: right 0.5rem center;
					background-repeat: no-repeat;
					background-size: 1.5em 1.5em;
					padding-right: 2.5rem;
				}
				select.form-input:is([multiple], [size]:not([size="1"])) {
					background-image: none;
					padding-right: 0.75rem;
				}
				@media (forced-colors: active) {
					select.form-input { appearance: auto; background-image: none; }
				}
				.form-input:focus {
					outline: none;
					border-color: var(--accent);
					box-shadow: 0 0 0 2px var(--accent-dim);
				}
				.input-secret .form-input {
					padding-right: 2.25rem;
				}

				/* --- Toggle --- */
				.toggle input { opacity: 0; width: 0; height: 0; }
				.toggle .slider {
					position: absolute;
					inset: 0;
					background: var(--border);
					border-radius: 10px;
					transition: background 0.15s;
				}
				.toggle .slider:before {
					content: "";
					position: absolute;
					height: 14px;
					width: 14px;
					left: 3px;
					bottom: 3px;
					background: var(--text);
					border-radius: 50%;
					transition: transform 0.15s;
				}
				.toggle input:checked + .slider { background: var(--accent); }
				.toggle input:focus-visible + .slider { outline: 2px solid var(--accent); outline-offset: 2px; }
				.toggle input:checked + .slider:before { transform: translateX(16px); }

				/* --- Stat cards --- */
				.stat-card-muted .stat-value { color: var(--text-muted); }

				/* --- Integration links --- */
				.integration-link .name {
					font-weight: 600;
					text-transform: capitalize;
				}
				.integration-link .meta {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					color: var(--text-muted);
				}

				/* --- Integration grid (cards) --- */
				.integration-card .name {
					font-weight: 600;
					text-transform: capitalize;
				}

				/* --- Tools list --- */
				.tool-row:last-child { border-bottom: none; }
				@media (max-width: 560px) {
					.tool-row { grid-template-columns: 1fr; gap: 0.125rem; }
				}

				/* --- Named identity editor --- */
				.identity-editor-header .badge {
					flex-shrink: 0;
					white-space: nowrap;
					color: var(--text-secondary);
				}
				.identity-editor .form-label { color: var(--text-secondary); }
				@media (max-width: 640px) {
					.identity-fields { grid-template-columns: 1fr; }
					.identity-item-heading { align-items: center; }
				}

				/* --- Footer --- */
				.footer code {
					background: var(--surface);
					padding: 2px 6px;
					border-radius: 3px;
					font-family: var(--font-mono);
				}

				/* --- Metrics: data table --- */
				.metrics-table th {
					text-align: left;
					font-weight: 500;
					color: var(--text-muted);
					padding: 0.375rem 0.75rem;
					border-bottom: 1px solid var(--border);
					text-transform: uppercase;
					letter-spacing: 0.04em;
				}
				.metrics-table td {
					padding: 0.375rem 0.75rem;
					border-bottom: 1px solid var(--border-subtle);
				}
				.metrics-table tr:last-child td { border-bottom: none; }
				.metrics-table .num {
					text-align: right;
					font-variant-numeric: tabular-nums;
					font-family: var(--font-mono);
				}
				.metrics-table .latency { color: var(--text-secondary); }
				.metrics-table .has-errors { color: var(--red); }
				.integration-name-cell a {
					color: var(--accent);
					text-decoration: none;
				}
				.integration-name-cell a:hover { text-decoration: underline; }

				/* --- Savings hero: headline value-prop card --- */
				.savings-hero::before {
					content: "";
					position: absolute;
					top: -40%;
					right: -10%;
					width: 320px;
					height: 320px;
					background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
					pointer-events: none;
				}

				/* --- Slack/setup-specific --- */
				.slack-desc code { background: var(--bg); padding: 2px 6px; border-radius: 3px; font-family: var(--font-mono); }
				.slack-step-detail kbd {
					background: var(--bg);
					border: 1px solid var(--border);
					border-radius: 3px;
					padding: 1px 5px;
					font-family: var(--font-mono);
				}
				.slack-link:hover { text-decoration: underline; }
				.slack-code-block pre { overflow-x: auto; margin: 0; }
				.slack-code-block code { font-family: var(--font-mono); color: var(--text-muted); white-space: pre-wrap; word-break: break-all; }
				.slack-code-block .btn { position: absolute; top: 0.375rem; right: 0.375rem; }
				.slack-token-meta strong { color: var(--text); font-weight: 600; }

				/* --- Responsive --- */
				@media (max-width: 768px) {
					.main { padding: 1.5rem; }
					.metrics-row { grid-template-columns: 1fr; }
					.savings-hero { padding: 1rem; }
					.savings-hero-value { font-size: 2rem; }
				}
				@media (max-width: 560px) {
					.btn { min-height: 40px; }
					.form-input { min-height: 42px; }
					.secret-toggle { width: 2.5rem; }
					.input-secret .form-input { padding-right: 2.75rem; }
					.toggle { width: 44px; height: 24px; }
					.toggle .slider { border-radius: 12px; }
					.toggle .slider:before { width: 18px; height: 18px; }
					.toggle input:checked + .slider:before { transform: translateX(20px); }
					.main { padding: 1rem; }
				}
			</style>
		</head>
		<body class="text-base font-normal text-content">
			@sidebar(data.CurrentPath)
			<div class="flex-1 min-w-0">
				@topbar(appearance)
				@searchDialog()
				@toastStack(data)
				<main class="main" tabindex="-1">
					{ children... }
				</main>
			</div>
			<script>
				function toggleSecret(btn) {
					var input = btn.parentElement.querySelector('input');
					var eyeOn = btn.querySelector('.eye-icon');
					var eyeOff = btn.querySelector('.eye-off-icon');
					if (input.type === 'password') {
						input.type = 'text';
						eyeOn.style.display = 'none';
						eyeOff.style.display = '';
					} else {
						input.type = 'password';
						eyeOn.style.display = '';
						eyeOff.style.display = 'none';
					}
				}
			</script>
		</body>
	</html>
}

templ appearanceBootstrap(appearance appearanceConfig) {
	@templ.JSONScript("appearance-config", appearance)
	<script id="appearance-bootstrap">
		(() => {
			const config = JSON.parse(document.getElementById('appearance-config').textContent);
			const dark = matchMedia('(prefers-color-scheme: dark)').matches;
			const scheme = dark ? 'dark' : 'light';
			const root = document.documentElement;
			root.dataset.theme = config.defaults[scheme];
			root.dataset.fontSize = '100';
			try {
				const theme = localStorage.getItem('switchboard.theme');
				const size = localStorage.getItem('switchboard.fontSize');
				const knownTheme = config.themes.some(option => option.id === theme);
				if (knownTheme) root.dataset.theme = theme;
				if (config.fontSizes.includes(size)) root.dataset.fontSize = size;
			} catch {}
		})();
	</script>
}

templ sidebar(currentPath string) {
	<nav id="sidebar" class="sidebar" aria-label="Main navigation">
		<div class="sidebar-brand">
			<div class="flex items-center justify-between gap-2">
				<div class="sidebar-brand-name">Switchboard</div>
				<button class="icon-button h-10 w-10" type="button" data-sidebar-close aria-label="Close sidebar" aria-controls="sidebar" disabled>
					<span class="i-lucide:x text-base" aria-hidden="true"></span>
				</button>
			</div>
		</div>
		for _, item := range navItems() {
			@navigationLink(item, currentPath)
		}
		<div class="sidebar-version">{ version.String() }</div>
	</nav>
}

templ navigationLink(item NavItem, currentPath string) {
	if isActive(currentPath, item.Path) {
		<a href={ templ.SafeURL(item.Path) } class="nav-item active" aria-current="page">
			<span class={ item.Icon, "w-[14px] h-[14px] shrink-0" } aria-hidden="true"></span>
			{ item.Label }
		</a>
	} else {
		<a href={ templ.SafeURL(item.Path) } class="nav-item">
			<span class={ item.Icon, "w-[14px] h-[14px] shrink-0" } aria-hidden="true"></span>
			{ item.Label }
		</a>
	}
}

templ topbar(appearance appearanceConfig) {
	<header class="topbar" aria-label="Navigation and appearance">
		<div class="flex items-center gap-2">
			<button class="icon-button h-10 w-10" type="button" data-sidebar-toggle aria-label="Toggle sidebar" aria-controls="sidebar" aria-expanded="true" disabled>
				<span class="i-lucide:panel-left text-base" aria-hidden="true"></span>
			</button>
			<span class="font-semibold text-lg hidden sm:inline">Switchboard</span>
		</div>
		<div class="appearance-controls ml-auto">
			<button class="icon-button h-10 gap-2 px-2" type="button" data-search-open aria-label="Search" aria-keyshortcuts="Meta+K Control+K" title="Search (⌘K / Ctrl+K)" aria-haspopup="dialog" aria-controls="search-dialog" disabled>
				<span class="i-lucide:search text-xl" aria-hidden="true"></span>
				<kbd class="font-mono text-sm text-muted" aria-hidden="true">⌘K</kbd>
			</button>
			@fontSizePicker(appearance.FontSizes)
			@themePicker(appearance.Themes)
		</div>
	</header>
}

templ fontSizePicker(fontSizes []string) {
	<details class="appearance-picker relative" data-font-picker>
		<summary class="icon-button h-10 w-10" aria-label="Font size" aria-disabled="true">
			<span class="i-lucide:a-large-small text-2xl" aria-hidden="true"></span>
		</summary>
		<div class="theme-options w-40" role="radiogroup" aria-label="Font size">
			for _, size := range fontSizes {
				<label class="theme-option">
					<input type="radio" name="font-size" value={ size } aria-label={ size + "%" } data-preference="fontSize" class="sr-only" checked?={ size == "100" } disabled/>
					<span class="font-size-option font-mono w-6" data-size={ size } aria-hidden="true">A</span>
					<span>{ size + "%" }</span>
					<span class="theme-check i-lucide:check ml-auto shrink-0" aria-hidden="true"></span>
				</label>
			}
		</div>
	</details>
}

templ themePicker(themes []themeOption) {
	<details class="appearance-picker theme-picker relative" data-theme-picker>
		<summary id="appearance-theme" class="icon-button h-10 w-10" aria-disabled="true">
			<span id="theme-label" class="sr-only">Theme</span>
			@themeSwatch(themes[0].ID)
			<span class="sr-only" data-theme-name>{ themes[0].Name }</span>
		</summary>
		<div class="theme-options" role="radiogroup" aria-labelledby="theme-label">
			for _, theme := range themes {
				<label class="theme-option">
					<input class="sr-only" type="radio" name="theme" value={ theme.ID } aria-label={ theme.Name } data-preference="theme" disabled/>
					@themeSwatch(theme.ID)
					<span>{ theme.Name }</span>
					<span class="theme-check i-lucide:check ml-auto shrink-0" aria-hidden="true"></span>
				</label>
			}
		</div>
	</details>
}

templ searchDialog() {
	<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
		<div class="flex items-center justify-between gap-3 mb-3">
			<h2 id="search-title" class="text-lg font-semibold">Search</h2>
			<form method="dialog">
				<button class="icon-button h-10 w-10" aria-label="Close search"><span class="i-lucide:x text-xl" aria-hidden="true"></span></button>
			</form>
		</div>
		<label for="route-search" class="sr-only">Search pages, integrations, and projects</label>
		<input id="route-search" class="form-input" type="search" placeholder="Search…" autocomplete="off" aria-describedby="search-status" disabled autofocus/>
		<p id="search-status" class="text-sm text-muted mt-3" role="status">Search pages, integrations, and projects.</p>
	</dialog>
}

templ toastStack(data PageData) {
	<div class="toast-stack">
		@refreshToast()
		if data.FlashSuccess != "" {
			@successToast(data.FlashSuccess)
		}
		if data.FlashError != "" {
			@errorToast(data.FlashError)
		}
	</div>
}

templ refreshToast() {
	<div id="page-refresh-status" class="toast flash" data-flash="refresh" role="status" aria-atomic="true" hidden>
		<span data-flash-message></span>
		<button type="button" class="flash-dismiss" data-dismiss-flash aria-label="Dismiss notification">
			<span class="i-lucide:x text-base" aria-hidden="true"></span>
		</button>
	</div>
}

templ successToast(message string) {
	<div class="toast flash flash-success" data-flash="success" data-auto-dismiss role="status" aria-atomic="true">
		<span>{ message }</span>
		<button type="button" class="flash-dismiss" data-dismiss-flash aria-label="Dismiss success message">
			<span class="i-lucide:x text-base" aria-hidden="true"></span>
		</button>
	</div>
}

templ errorToast(message string) {
	<div class="toast flash flash-error" data-flash="error" role="alert" aria-atomic="true">
		<span>{ message }</span>
		<button type="button" class="flash-dismiss" data-dismiss-flash aria-label="Dismiss error message">
			<span class="i-lucide:x text-base" aria-hidden="true"></span>
		</button>
	</div>
}
