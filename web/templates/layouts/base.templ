package layouts

import (
	"strings"

	"github.com/daltoniam/switchboard/version"
)

type PageData struct {
	Title         string
	CurrentPath   string
	FlashSuccess  string
	FlashError    string
	Version       string
}

type NavItem struct {
	Path  string
	Label string
	Icon  string
}

func navItems() []NavItem {
	return []NavItem{
		{Path: "/", Label: "Dashboard", Icon: "⚡"},
		{Path: "/projects", Label: "Projects", Icon: "📁"},
		{Path: "/integrations", Label: "Integrations", Icon: "🔌"},
		{Path: "/plugins", Label: "Plugin Marketplace", Icon: "🏪"},
		{Path: "/settings", Label: "Settings", Icon: "⚙"},
	}
}

func isActive(current, path string) bool {
	if path == "/" {
		return current == "/"
	}
	return strings.HasPrefix(current, path)
}

templ Base(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title } — Switchboard</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<style>
				:root {
					--accent-dim:     color-mix(in srgb, var(--accent) 12%, transparent);
					--accent-active:  color-mix(in srgb, var(--accent) 24%, transparent);
					--green-dim:      color-mix(in srgb, var(--green) 12%, transparent);
					--red-dim:        color-mix(in srgb, var(--red) 12%, transparent);
					--yellow-dim:     color-mix(in srgb, var(--yellow) 12%, transparent);
					--radius:         6px;
					--font-mono:      'SF Mono', ui-monospace, 'Cascadia Code', 'Fira Code', Menlo, monospace;
				}
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, Helvetica, Arial, sans-serif;
					background: var(--bg);
					line-height: 1.5;
					display: flex;
					min-height: 100vh;
					-webkit-font-smoothing: antialiased;
				}

				/* --- Sidebar --- */
				.sidebar {
					width: 200px;
					background: var(--surface);
					border-right: 1px solid var(--border-subtle);
					padding: 1.25rem 0;
					flex-shrink: 0;
					display: flex;
					flex-direction: column;
				}
				.sidebar-brand {
					padding: 0 1rem 1rem;
					border-bottom: 1px solid var(--border-subtle);
					margin-bottom: 0.5rem;
				}
				.sidebar-brand-name {
					font-size: 0.875rem;
					font-weight: 600;
					color: var(--text);
					letter-spacing: -0.01em;
				}
				.sidebar-brand-sub {
					color: var(--text-muted);
					font-size: 0.6875rem;
					display: block;
					margin-top: 0.125rem;
				}
				.nav-item {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					padding: 0.4375rem 1rem;
					color: var(--text-secondary);
					text-decoration: none;
					font-size: 0.8125rem;
					border-left: 2px solid transparent;
					transition: color 0.1s, background 0.1s;
				}
				.nav-item:hover {
					background: var(--surface-hover);
					color: var(--text);
				}
				.nav-item.active {
					color: var(--accent);
					border-left-color: var(--accent);
					background: var(--accent-dim);
				}
				.sidebar-version {
					margin-top: auto;
					padding: 0.75rem 1rem;
					border-top: 1px solid var(--border-subtle);
					color: var(--text-muted);
					font-size: 0.625rem;
					font-family: var(--font-mono);
				}

				@media (prefers-reduced-motion: reduce) {
					*, *::before, *::after { animation: none !important; transition: none !important; }
				}

				/* --- Forms --- */
				select.form-input {
					appearance: none;
					background-image: var(--select-chevron);
					background-position: right 0.5rem center;
					background-repeat: no-repeat;
					background-size: 1.5em 1.5em;
					padding-right: 2.5rem;
				}
				select.form-input:is([multiple], [size]:not([size="1"])) {
					background-image: none;
					padding-right: 0.75rem;
				}
				@media (forced-colors: active) {
					select.form-input { appearance: auto; background-image: none; }
				}
				.form-input:focus {
					outline: none;
					border-color: var(--accent);
					box-shadow: 0 0 0 2px var(--accent-dim);
				}
				.input-secret .form-input {
					padding-right: 2.25rem;
				}

				/* --- Toggle --- */
				.toggle input { opacity: 0; width: 0; height: 0; }
				.toggle .slider {
					position: absolute;
					inset: 0;
					background: var(--border);
					border-radius: 10px;
					transition: background 0.15s;
				}
				.toggle .slider:before {
					content: "";
					position: absolute;
					height: 14px;
					width: 14px;
					left: 3px;
					bottom: 3px;
					background: var(--text);
					border-radius: 50%;
					transition: transform 0.15s;
				}
				.toggle input:checked + .slider { background: var(--accent); }
				.toggle input:focus-visible + .slider { outline: 2px solid var(--accent); outline-offset: 2px; }
				.toggle input:checked + .slider:before { transform: translateX(16px); }

				/* --- Stat cards --- */
				.stat-card-green { border-color: oklch(65% 0.17 155 / 0.25); }
				.stat-card-green .stat-value { color: var(--green); }
				.stat-card-yellow { border-color: oklch(72% 0.15 80 / 0.25); }
				.stat-card-yellow .stat-value { color: var(--yellow); }
				.stat-card-muted .stat-value { color: var(--text-muted); }

				/* --- Integration links --- */
				.integration-link .name {
					font-weight: 600;
					text-transform: capitalize;
				}
				.integration-link .meta {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					color: var(--text-muted);
				}

				.last-check { color: var(--text-muted); font-size: 0.625rem; margin-left: 0.5rem; }

				/* --- Integration grid (cards) --- */
				.integration-card .name {
					font-weight: 600;
					text-transform: capitalize;
				}

				/* --- Tools list --- */
				.tool-row:last-child { border-bottom: none; }
				@media (max-width: 560px) {
					.tool-row { grid-template-columns: 1fr; gap: 0.125rem; }
				}

				/* --- Named identity editor --- */
				.identity-editor-header .badge {
					flex-shrink: 0;
					white-space: nowrap;
					color: var(--text-secondary);
				}
				.identity-editor .form-label { color: var(--text-secondary); }
				@media (max-width: 640px) {
					.identity-fields { grid-template-columns: 1fr; }
					.identity-item-heading { align-items: center; }
				}

				/* --- Footer --- */
				.footer code {
					background: var(--surface);
					padding: 2px 6px;
					border-radius: 3px;
					font-family: var(--font-mono);
				}

				/* --- Metrics: data table --- */
				.metrics-table th {
					text-align: left;
					font-weight: 500;
					color: var(--text-muted);
					padding: 0.375rem 0.75rem;
					border-bottom: 1px solid var(--border);
					text-transform: uppercase;
					letter-spacing: 0.04em;
				}
				.metrics-table td {
					padding: 0.375rem 0.75rem;
					border-bottom: 1px solid var(--border-subtle);
				}
				.metrics-table tr:last-child td { border-bottom: none; }
				.metrics-table .num {
					text-align: right;
					font-variant-numeric: tabular-nums;
					font-family: var(--font-mono);
				}
				.metrics-table .latency { color: var(--text-secondary); }
				.metrics-table .has-errors { color: var(--red); }
				.integration-name-cell a {
					color: var(--accent);
					text-decoration: none;
				}
				.integration-name-cell a:hover { text-decoration: underline; }

				/* --- Savings hero: headline value-prop card --- */
				.savings-hero::before {
					content: "";
					position: absolute;
					top: -40%;
					right: -10%;
					width: 320px;
					height: 320px;
					background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
					pointer-events: none;
				}

				/* --- Slack/setup-specific --- */
				.slack-desc code { background: var(--bg); padding: 2px 6px; border-radius: 3px; font-family: var(--font-mono); }
				.slack-step-detail kbd {
					background: var(--bg);
					border: 1px solid var(--border);
					border-radius: 3px;
					padding: 1px 5px;
					font-family: var(--font-mono);
				}
				.slack-link:hover { text-decoration: underline; }
				.slack-code-block pre { overflow-x: auto; margin: 0; }
				.slack-code-block code { font-family: var(--font-mono); color: var(--text-muted); white-space: pre-wrap; word-break: break-all; }
				.slack-code-block .btn { position: absolute; top: 0.375rem; right: 0.375rem; }
				.slack-token-meta strong { color: var(--text); font-weight: 600; }

				/* --- Spinner --- */
				.spinner {
					display: inline-block;
					width: 12px;
					height: 12px;
					border: 2px solid var(--border);
					border-top-color: var(--accent);
					border-radius: 50%;
					animation: spin 0.6s linear infinite;
					vertical-align: middle;
				}
				@keyframes spin { to { transform: rotate(360deg); } }

				/* --- Responsive --- */
				@media (max-width: 768px) {
					.sidebar { width: 180px; }
					.main { padding: 1.5rem; }
					.metrics-grid { grid-template-columns: repeat(2, 1fr); }
					.metrics-row { grid-template-columns: 1fr; }
					.stats-grid { grid-template-columns: repeat(2, 1fr); }
					.integration-grid { grid-template-columns: repeat(2, 1fr); }
					.savings-buckets { grid-template-columns: repeat(2, 1fr); }
					.savings-hero { padding: 1rem; }
					.savings-hero-value { font-size: 2rem; }
				}
				@media (max-width: 560px) {
					body { flex-direction: column; }
					.btn { min-height: 40px; }
					.form-input { min-height: 42px; }
					.secret-toggle { width: 2.5rem; }
					.input-secret .form-input { padding-right: 2.75rem; }
					.toggle { width: 44px; height: 24px; }
					.toggle .slider { border-radius: 12px; }
					.toggle .slider:before { width: 18px; height: 18px; }
					.toggle input:checked + .slider:before { transform: translateX(20px); }
					.sidebar {
						width: 100%;
						flex-direction: row;
						padding: 0.5rem 0;
						border-right: none;
						border-bottom: 1px solid var(--border-subtle);
						overflow-x: auto;
					}
					.sidebar-brand { display: none; }
					.nav-item {
						border-left: none;
						border-bottom: 2px solid transparent;
						padding: 0.375rem 0.75rem;
						white-space: nowrap;
					}
					.nav-item.active { border-left-color: transparent; border-bottom-color: var(--accent); }
					.main { padding: 1rem; }
					.integration-grid { grid-template-columns: 1fr; }
					.savings-buckets { grid-template-columns: 1fr; }
				}
			</style>
		</head>
		<body class="text-base font-normal text-content">
			<nav class="sidebar">
				<div class="sidebar-brand">
					<div class="sidebar-brand-name">⚙ Switchboard</div>
					<span class="sidebar-brand-sub">Server Configuration</span>
				</div>
				for _, item := range navItems() {
					if isActive(data.CurrentPath, item.Path) {
						<a href={ templ.SafeURL(item.Path) } class="nav-item active">{ item.Icon } { item.Label }</a>
					} else {
						<a href={ templ.SafeURL(item.Path) } class="nav-item">{ item.Icon } { item.Label }</a>
					}
				}
				<div class="sidebar-version">{ version.String() }</div>
			</nav>
			<main class="main">
				if data.FlashSuccess != "" {
					<div class="flash flash-success">{ data.FlashSuccess }</div>
				}
				if data.FlashError != "" {
					<div class="flash flash-error">{ data.FlashError }</div>
				}
				{ children... }
			</main>
			<script>
				function toggleSecret(btn) {
					var input = btn.parentElement.querySelector('input');
					var eyeOn = btn.querySelector('.eye-icon');
					var eyeOff = btn.querySelector('.eye-off-icon');
					if (input.type === 'password') {
						input.type = 'text';
						eyeOn.style.display = 'none';
						eyeOff.style.display = '';
					} else {
						input.type = 'password';
						eyeOn.style.display = '';
						eyeOff.style.display = 'none';
					}
				}
			</script>
		</body>
	</html>
}
