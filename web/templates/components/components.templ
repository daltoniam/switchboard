package components

import "fmt"

templ Badge(label string, variant string) {
	<span class={ "badge badge-" + variant }>{ label }</span>
}

templ Toggle(name string, checked bool) {
	<label class="toggle">
		if checked {
			<input type="checkbox" name={ name } value="true" checked/>
		} else {
			<input type="checkbox" name={ name } value="true"/>
		}
		<span class="slider"></span>
	</label>
}

templ FormGroup(label string, name string, inputType string, value string, placeholder string) {
	<div class="form-group">
		<label class="form-label" for={ name }>{ label }</label>
		if inputType == "password" {
			<div class="input-secret">
				<input class="form-input" type="password" name={ name } id={ name } value={ value } placeholder={ placeholder }/>
				<button type="button" class="secret-toggle" onclick="toggleSecret(this)" aria-label="Toggle visibility">
					<svg class="eye-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
						<path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"></path>
						<path fill-rule="evenodd" clip-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"></path>
					</svg>
					<svg class="eye-off-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" style="display:none">
						<path fill-rule="evenodd" clip-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z"></path>
						<path d="M10.748 13.93l2.523 2.523a9.987 9.987 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"></path>
					</svg>
				</button>
			</div>
		} else {
			<input class="form-input" type={ inputType } name={ name } id={ name } value={ value } placeholder={ placeholder }/>
		}
	</div>
}

templ StatCard(value int, label string) {
	<div class="stat-card">
		<div class="stat-value">{ fmt.Sprint(value) }</div>
		<div class="stat-label">{ label }</div>
	</div>
}

templ StatCardColor(value int, label string, variant string) {
	<div class={ "stat-card", "stat-card-" + variant }>
		<div class="stat-value">{ fmt.Sprint(value) }</div>
		<div class="stat-label">{ label }</div>
	</div>
}

templ ToolRow(name string, description string) {
	<div class="tool-row">
		<code class="tool-row-name">{ name }</code>
		if description != "" {
			<div class="tool-row-desc">{ description }</div>
		} else {
			<div class="tool-row-desc tool-row-desc-empty">No description available</div>
		}
	</div>
}
